{
  "manifest_version": 3,
  "name": "Discord Hack Cleaner",
  "version": "1.0.1",
  "description": "Find and remove scam messages sent from your Discord account after a hack or session token theft.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://discord.com/api/*",
    "https://cdn.discordapp.com/attachments/*",
    "https://media.discordapp.net/attachments/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": { "service_worker": "src/worker.js" },
  "action": {
    "default_title": "Discord Hack Cleaner",
    "default_icon": {
      "16": "assets/icon-16.png",
      "24": "assets/icon-24.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "src/popup.html"
  }
}
